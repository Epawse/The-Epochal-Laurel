# Copy this file to .env.local and fill in real keys. Never commit .env.local.

# ============================================================
# LLM Providers (at least one required for AI features)
# ============================================================

# DeepSeek (primary provider) — get a key at https://platform.deepseek.com
# OpenAI-compatible endpoint: https://api.deepseek.com
DEEPSEEK_API_KEY=

# Google Gemini (fallback provider) — get a key at https://aistudio.google.com/apikey
# OpenAI-compat endpoint: https://generativelanguage.googleapis.com/v1beta/openai/
GOOGLE_GENERATIVE_AI_API_KEY=

# ============================================================
# Supabase (optional — game works without it, leaderboard disabled)
# ============================================================

# Get these from your Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ============================================================
# Deployment Notes
# ============================================================
# - The app gracefully degrades without Supabase (leaderboard disabled)
# - At least one LLM provider key is needed for AI-generated content
# - If both providers are missing, static fallback content is shown
