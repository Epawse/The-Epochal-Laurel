# Copy this file to .env.local and fill in real keys. Never commit .env.local.

# DeepSeek (primary provider) — get a key at https://platform.deepseek.com
# OpenAI-compatible endpoint: https://api.deepseek.com
DEEPSEEK_API_KEY=

# Google Gemini (fallback provider) — get a key at https://aistudio.google.com/apikey
# OpenAI-compat endpoint: https://generativelanguage.googleapis.com/v1beta/openai/
GOOGLE_GENERATIVE_AI_API_KEY=
